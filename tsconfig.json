{
  "compilerOptions": {
    "module": "commonjs", "declaration": true, "removeComments": true,
    "emitDecoratorMetadata": true, "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true, "target": "ES2022", "sourceMap": true,
    "outDir": "./dist", "baseUrl": "./", "incremental": true,
    "strict": true, "strictPropertyInitialization": false,
    "noImplicitAny": true, "strictNullChecks": true, "noUncheckedIndexedAccess": true,
    "esModuleInterop": true, "skipLibCheck": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "integration/**/*.ts"]
}
